# Server Configuration
PORT=3000

# Ollama Configuration
OLLAMA_HOST_DECISION=http://127.0.0.1:11434
OLLAMA_HOST_CHOICE=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=300000
DECISION_MODEL=stable-unified
CHOICE_MODEL=stable-unified

# OpenAI Configuration
AI_PROVIDER=ollama
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DECISION_MODEL=gpt-3.5-turbo
OPENAI_CHOICE_MODEL=gpt-4
OPENAI_TIMEOUT_MS=300000

# Database Configuration
DB_PATH=./data/stable.db

# Memory Configuration
MEMORY_SUMMARY_LENGTH=1000

# Idle Detection
IDLE_TIMEOUT_MS=300000