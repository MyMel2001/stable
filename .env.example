# OpenAI or Ollama?
AI_PROVIDER='openai'

# Server Configuration
PORT=3000

# Ollama Configuration
OLLAMA_HOST_DECISION=http://127.0.0.1:11434
OLLAMA_HOST_CHOICE=http://127.0.0.1:11434
OLLAMA_TIMEOUT_MS=300000
DECISION_MODEL=deepseek-r1:14b
CHOICE_MODEL=qwen3.5:9b

# OpenAI Configuration
OPENAI_API_KEY=x
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_DECISION_MODEL=openrouter/free
OPENAI_CHOICE_MODEL=openrouter/free
OPENAI_TIMEOUT_MS=1200000

# Database Configuration
DB_PATH=./data/stable.db

# Memory Configuration
MEMORY_SUMMARY_LENGTH=1000

# Idle Detection
IDLE_TIMEOUT_MS=300000